# GEMINI_API_KEY: Optional for server-side Gemini AI features if enabled later.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# SITE_URL / APP_URL: Public canonical base URL of your deployed AIVORA AI instance.
# Examples:
#   Local development: SITE_URL="http://localhost:3000"
#   Production domain: SITE_URL="https://aivora.ai"
SITE_URL="http://localhost:3000"
APP_URL="http://localhost:3000"
VITE_SITE_URL=""

# SUPABASE (Publishable key + URL with PostgreSQL Row Level Security)
# Find these in Supabase Dashboard -> Project Settings -> API
# Never expose any private service_role key in browser code.
VITE_SUPABASE_URL=""
VITE_SUPABASE_ANON_KEY=""

